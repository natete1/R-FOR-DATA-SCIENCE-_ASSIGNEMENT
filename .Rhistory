data <- data.frame(
Student = c("Alice", "Bob", "Charlie", "David"),
Marks = c(80, 90, 70, 85)
)
ggplot(data, aes(x = Student, y = Marks)) +
geom_bar(stat = "identity", fill = "blue") +
labs(
title = "Students' Marks",
x = "Student Name",
y = "Marks"
)
